<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="알림 거리 설정"
        android:summary="목적지로부터의 거리에 따라 알림을 받습니다">

        <EditTextPreference
            android:key="alert_distance_1"
            android:title="첫 번째 알림 거리"
            android:summary="목적지까지 남은 거리 (미터)"
            android:defaultValue="1000"
            android:inputType="number"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="alert_distance_2"
            android:title="두 번째 알림 거리"
            android:summary="목적지까지 남은 거리 (미터)"
            android:defaultValue="500"
            android:inputType="number"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="alert_distance_3"
            android:title="세 번째 알림 거리"
            android:summary="목적지까지 남은 거리 (미터)"
            android:defaultValue="200"
            android:inputType="number"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="알림 설정">

        <SeekBarPreference
            android:key="alert_volume"
            android:title="알림 음량"
            android:summary="알림 소리의 최대 음량"
            android:defaultValue="50"
            android:max="100"
            app:showSeekBarValue="true" />

        <SwitchPreferenceCompat
            android:key="vibrate_enabled"
            android:title="진동 사용"
            android:summary="알림 시 진동 사용"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="sound_enabled"
            android:title="소리 사용"
            android:summary="알림 시 소리 사용"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="추가 정보">

        <Preference
            android:title="앱 정보"
            android:summary="대중교통 이용 시 목적지 근접 알림 앱 v1.0" />

        <Preference
            android:title="사용 방법"
            android:summary="1. 지도에서 목적지를 선택하세요\n2. 알림 거리를 설정하세요\n3. 추적 시작 버튼을 누르세요" />

    </PreferenceCategory>

</PreferenceScreen>
